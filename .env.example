# Copy to .env for local development. Never commit .env.
# One root .env is shared by docker-compose and all apps in local dev.

# --- Database (docker-compose) -------------------------------------------
POSTGRES_USER=matiq
POSTGRES_PASSWORD=matiq
POSTGRES_DB=matiq
POSTGRES_PORT=5432
DATABASE_URL=postgres://matiq:matiq@localhost:5432/matiq

# --- App URLs ------------------------------------------------------------
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173

# --- API -----------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Mail ----------------------------------------------------------------
# smtp = Mailpit locally (UI: http://localhost:8025), brevo = production
MAIL_PROVIDER=smtp
MAIL_FROM="MatIQ <no-reply@matiq.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# BREVO_API_KEY=

# --- Auth (phase 2) ------------------------------------------------------
# BETTER_AUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

