{
  "name": "@matiq/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node src/seed/run.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@matiq/contracts": "workspace:*",
    "@matiq/roadmap": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "@matiq/config": "workspace:*",
    "@types/node": "^26.6.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.2"
  }
}
