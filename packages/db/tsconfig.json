{
  "extends": "@matiq/config/tsconfig/library.json",
  "compilerOptions": {
    // tsup builds the package; tsc only type-checks.
    "noEmit": true,
    // Lets Node run src/*.ts directly (scripts like migrate/seed).
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["src", "drizzle.config.ts", "tsup.config.ts"]
}
